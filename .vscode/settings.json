{
    "python.formatting.provider": "black",
    "python.linting.mypyEnabled": true,
    "editor.formatOnSave": true,
    "cSpell.words": [
        "ABCDEFGHJKLMNPQRTUVXYZ",
        "addopts",
        "autoflake",
        "autoplay",
        "beforerun",
        "dataclass",
        "datafiles",
        "direnv",
        "envrc",
        "expecter",
        "gridcommand",
        "gunicorn",
        "honcho",
        "htmlcov",
        "isort",
        "Jace",
        "livereload",
        "minilog",
        "mypy",
        "nobeep",
        "onpass",
        "pluginmanager",
        "pomace",
        "procfile",
        "ptw",
        "pyproject",
        "pytest",
        "pythonanywhere",
        "showfspath",
        "venv",
        "virtualenvs",
        "werkzeug"
    ],
    "files.exclude": {
        "**/__pycache__/": true,
        ".cache/": true,
        ".venv/": true
    }
}
