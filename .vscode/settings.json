{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "editor.formatOnSave": true,
    "pylint.args": [
        "--disable=C"
    ],
    "cSpell.words": [
        "ABCDEFGHJKLMNPQRTUVXYZ",
        "addopts",
        "autoflake",
        "autoplay",
        "beforerun",
        "dataclass",
        "datafiles",
        "direnv",
        "envrc",
        "expecter",
        "gridcommand",
        "gunicorn",
        "honcho",
        "htmlcov",
        "isort",
        "Jace",
        "livereload",
        "minilog",
        "mypy",
        "nobeep",
        "onpass",
        "pluginmanager",
        "pomace",
        "procfile",
        "ptw",
        "pyproject",
        "pytest",
        "pythonanywhere",
        "setuptools",
        "showfspath",
        "venv",
        "virtualenvs",
        "werkzeug"
    ],
    "files.exclude": {
        "**/__pycache__/": true,
        ".cache/": true,
        ".venv/": true
    },
    "djlint.showInstallError": false
}
